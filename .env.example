# Google Drive Service Account JSON (base64-encoded)
# Copier ce fichier vers .env et remplacer par vos vraies valeurs
# IMPORTANT: .env ne doit JAMAIS être commité (déjà dans .gitignore)

# Format: JSON encodé en base64 sur une seule ligne
GCP_SERVICE_ACCOUNT_KEY_B64='YOUR_BASE64_ENCODED_JSON_HERE'

# ID du dossier Google Drive racine où uploader les fichiers
# Trouvez l'ID dans l'URL : https://drive.google.com/drive/folders/[FOLDER_ID]
DRIVE_FOLDER_ID='YOUR_DRIVE_FOLDER_ID_HERE'

# Pour encoder votre clé JSON en base64:
# 
# Linux/macOS/WSL:
#   cat service-account.json | base64 -w 0
#
# Windows PowerShell:
#   [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((Get-Content service-account.json -Raw)))
#
# Puis coller le résultat dans GCP_SERVICE_ACCOUNT_KEY_B64 ci-dessus

# Pour obtenir votre Service Account JSON:
# 1. Aller sur Google Cloud Console → https://console.cloud.google.com
# 2. IAM & Admin → Service Accounts
# 3. Créer un Service Account (ou utiliser existant)
# 4. Keys → Add Key → Create new key → JSON
# 5. Télécharger le fichier JSON
# 6. Encoder en base64 (voir commandes ci-dessus)
# 7. Donner accès au dossier Drive : Partager le dossier avec l'email du service account
